# Copy to backend/.env and fill in. .env is gitignored; this file is committed.
#
#   cp backend/.env.example backend/.env
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   # JWT_SECRET
#   createdb quizzle && npm run migrate

PORT=8787

# Required. The server refuses to boot without it.
DATABASE_URL=postgres://localhost:5432/quizzle

# Required. 32+ random bytes. Rotating it invalidates every access token.
JWT_SECRET=

# Explicit allowlist — comma separated, no wildcard. A browser origin that is
# not listed is refused. `flutter run -d chrome --web-port 8090` is the first.
CORS_ORIGINS=http://localhost:8090,http://localhost:5000

# Token lifetimes.
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# bcrypt cost. 12 is the contract; lower it only for a test database.
BCRYPT_COST=12

# Question generation: "mock" (offline, default) or "anthropic".
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# A real model id. claude-sonnet-5 does not exist and returns 400.
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Limits.
BODY_LIMIT_BYTES=1048576
UPLOAD_LIMIT_BYTES=20971520
# Failed sign-ins per (IP, email) per 15 min. A whole class shares one school IP,
# so this is per account, with a separate per-IP ceiling below.
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_IP=300
RATE_LIMIT_GENERATE=20
# Requests per signed-in user per minute (per IP when anonymous).
RATE_LIMIT_GLOBAL=600

# Reverse proxies in front of this server. Leave at 0 when clients connect
# directly: any higher and a client can choose its own IP with X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Realtime.
PRESENCE_GRACE_MS=5000
WS_MAX_PAYLOAD_BYTES=65536

LOG_LEVEL=info
